# Non-secret template. Copy to .local/internal.env on the deployment host.
OIDC_ISSUER=https://sso.corp.example/realms/corp
OIDC_JWKS_URI=https://sso.corp.example/realms/corp/protocol/openid-connect/certs
MCP_PUBLIC_URL=https://outlook-mcp.corp.example
EWS_ENDPOINT=https://mail.corp.example/EWS/Exchange.asmx
EWS_USERNAME=CORP\svc-outlook-mcp
LITELLM_NETWORK=litellm_guardrails_default
MCP_HOST_PORT=8767

# Register this MCP client at AAS; its callback is MCP_PUBLIC_URL/auth/callback.
AAS_AUTHORIZATION_ENDPOINT=https://aas.corp.example/authorize
AAS_TOKEN_ENDPOINT=https://aas.corp.example/token
AAS_CLIENT_ID=outlook-mcp
MCP_CLIENT_REDIRECT_URIS='["https://litellm.corp.example/callback"]'
# Mount .local/internal/aas-client-secret and oauth-signing-key separately.
